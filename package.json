{
  "name": "decky-ssh",
  "version": "0.1.4",
  "private": true,
  "description": "SSH on/off, start at boot, and account password controls for Steam Deck.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python -B -m unittest discover -s tests -v",
    "package": "node scripts/check-version.mjs && npm run clean && npm run typecheck && npm run build && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.12.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "fflate": "0.8.3",
    "rollup": "4.63.2",
    "typescript": "5.9.3"
  }
}
